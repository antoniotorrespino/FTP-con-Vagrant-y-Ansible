options {
    directory "/var/cache/bind";

    // La recursión solo se permite al propio servidor y a la red privada
    recursion yes;
    allow-recursion { 127.0.0.1; 192.168.57.0/24; };

    // Servidor al que se reenvían las consultas de otros dominios
    forwarders { 8.8.8.8; };

    dnssec-validation no;
    listen-on-v6 { any; };
};